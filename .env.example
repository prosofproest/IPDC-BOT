# ---- Optional overrides (defaults are already correct for IPDC) ----
# GRID_ROLE_ID=1568690888413282396     # IPDC GRID (manually assigned; bot never grants it)
# ADMIN_ROLE_ID=1568690393824891141    # ADMIN (support access baseline)
# IPDC_ROLE_ID=                        # leave unset: bot adopts an existing "IPDC" role or creates it once
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_TIMEOUT_MS=8000                   # Gemini timeout before immediate Groq failover
# PORT=                                # set to the host-provided port to enable /health and the GitHub webhook endpoint
# GITHUB_TOKEN=                        # alternative to a GitHub App: read-only fine-grained token
# CODE_OF_CONDUCT_FILE=config/code-of-conduct.txt
